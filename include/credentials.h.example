#pragma once

// Copy this file to credentials.h (gitignored) and fill in real values.

#define WIFI_SSID            "your-ssid"
#define WIFI_PASSWORD        "your-password"

// Create a bot with @BotFather on Telegram, then have the human
// press /start in that chat so the bot is allowed to message them.
#define TELEGRAM_BOT_TOKEN   "123456:ABC-your-token"

// Your numeric chat ID (get it from @userinfobot, or the bridge config).
#define TELEGRAM_CHAT_ID     "123456789"
// The computer running ota/server.py — its LAN IP. Leave empty to disable OTA
// updates (the board silently skips the check when it can't reach the server).
#define OTA_HOST           ""
